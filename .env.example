# Copy to .env.local and fill in. Never commit .env.local.

# Local dev database (see docker-compose.yml). Railway supplies this in production.
DATABASE_URL=postgresql://tipsrum:tipsrum@localhost:5432/tipsrum

# Better-Auth. Generate a secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
# Public origin of the app (no trailing slash). Railway sets the production value.
BETTER_AUTH_URL=http://localhost:3000

# Stripe (test mode while developing). Secret key from Dashboard > Developers > API keys.
STRIPE_SECRET_KEY=
# Signing secret: in dev, the whsec_... that `pnpm stripe:listen` prints on start.
# In production, the secret of the dashboard webhook endpoint for /api/stripe/webhook.
STRIPE_WEBHOOK_SECRET=
